# Dataset paths — point to the actual downloaded data outside the project folder.
# Paths are resolved relative to the repository root (ventassist/).
MIMIC_IV_HOSP_PATH=files/mimiciv/3.1/hosp
MIMIC_IV_ICU_PATH=files/mimiciv/3.1/icu
WAVEFORM_PATH=files/mimic4wdb/0.1.0
WAVEFORM_WAVES_PATH=files/mimic4wdb/0.1.0/waves

# Pipeline output path (inside the project)
PROCESSED_PATH=backend/data/processed
MODEL_PATH=backend/models

# API settings
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Database
DATABASE_URL=sqlite:///./ventassist.db

# Model files (relative to project root) — Dual-Track
TRACK_A_MODEL=backend/models/policy_track_a.pt
TRACK_B_MODEL=backend/models/policy_track_b.pt
NWE_MODEL=backend/models/nwe_model.pkl
NORMALISER_TRACK_A=backend/models/normaliser_stats.json
NORMALISER_TRACK_B=backend/models/normaliser_stats_track_b.json

# Safety thresholds
MAX_PEEP=15
MAX_FIO2=0.8
MAX_TV_ML_PER_KG=8.0

# MongoDB Atlas — patient roster + recommendation history.
# Copy to backend/.env and fill in real credentials (backend/.env is gitignored).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB=ventassist

# Clinician sign-in. AUTH_SECRET signs the session tokens — generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leaving it unset is safe but re-randomises on every restart, which signs
# everyone out. TTL is how long a session lasts before sign-in is asked for again.
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=12
